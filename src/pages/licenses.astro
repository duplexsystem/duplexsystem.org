---
import BaseLayout from '../layouts/BaseLayout.astro';
import Panel from '../components/Panel.astro';

const REPO = 'https://github.com/duplexsystem/duplexsystem.org';
const AGPL = 'https://directory.fsf.org/wiki/License:AGPLv3';
// FSF calls it Expat; the projects call it MIT. Canonical URL, familiar name.
const MIT = 'https://directory.fsf.org/wiki/License:Expat';
const EMBED_SRC = (pkg) =>
  `https://github.com/delucis/astro-embed/tree/main/packages/astro-embed-${pkg}`;

const PAGEFIND_VERSION = '1.5.2';
const KATEX_VERSION = '0.18.1';
const PAGEFIND_SRC = `https://github.com/CloudCannon/pagefind/archive/refs/tags/v${PAGEFIND_VERSION}.tar.gz`;
const PAGEFIND_SOURCE_LABEL = `pagefind-${PAGEFIND_VERSION}.tar.gz`;

const SCRIPTS = [
  {
    file: '/js/image-fade.js',
    license: 'AGPL-3.0-or-later',
    licenseUrl: AGPL,
    source: REPO,
    sourceLabel: 'duplexsystem.org',
  },
  {
    file: '/js/copy-code.js',
    license: 'AGPL-3.0-or-later',
    licenseUrl: AGPL,
    source: REPO,
    sourceLabel: 'duplexsystem.org',
  },
  {
    file: '/js/search-terms.js',
    license: 'AGPL-3.0-or-later',
    licenseUrl: AGPL,
    source: REPO,
    sourceLabel: 'duplexsystem.org',
  },
  {
    file: '/js/crack-email.js',
    license: 'AGPL-3.0-or-later',
    licenseUrl: AGPL,
    source: REPO,
    sourceLabel: 'duplexsystem.org',
  },
  // astro-embed's custom-element definitions, pulled into real files by
  // scripts/extract_inline_scripts.mjs because the CSP blocks inline execution.
  {
    file: '/js/lite-youtube.js',
    license: 'MIT',
    licenseUrl: MIT,
    source: EMBED_SRC('youtube'),
    sourceLabel: 'astro-embed-youtube',
  },
  {
    file: '/js/lite-vimeo.js',
    license: 'MIT',
    licenseUrl: MIT,
    source: EMBED_SRC('vimeo'),
    sourceLabel: 'astro-embed-vimeo',
  },
  {
    file: '/pagefind/pagefind.js',
    license: 'MIT',
    licenseUrl: MIT,
    source: PAGEFIND_SRC,
    sourceLabel: PAGEFIND_SOURCE_LABEL,
  },
  {
    file: '/pagefind/pagefind-component-ui.js',
    license: 'MIT',
    licenseUrl: MIT,
    source: PAGEFIND_SRC,
    sourceLabel: PAGEFIND_SOURCE_LABEL,
  },
  {
    file: '/pagefind/pagefind-worker.js',
    license: 'MIT',
    licenseUrl: MIT,
    source: PAGEFIND_SRC,
    sourceLabel: PAGEFIND_SOURCE_LABEL,
  },
];

const licenseTexts = import.meta.glob('../assets/licenses/*.txt', {
  eager: true,
  query: '?raw',
  import: 'default',
});
const COMPONENTS = [
  {
    name: 'Literata',
    version: 'variable',
    holder: 'Copyright 2018 The Literata Project Authors',
    license: 'SIL Open Font License, Version 1.1',
    file: 'Literata-OFL.txt',
    url: 'https://github.com/googlefonts/literata',
  },
  {
    name: 'Departure Mono',
    version: '1.500',
    holder: 'Copyright (c) 2024 Helena Zhang & Tobias Fried',
    license: 'MIT License',
    file: 'DepartureMono-MIT.txt',
    url: 'https://departuremono.com/',
  },
  {
    name: 'JetBrains Mono',
    version: '2.304',
    holder: 'Copyright 2020 The JetBrains Mono Project Authors',
    license: 'SIL Open Font License, Version 1.1',
    file: 'JetBrainsMono-OFL.txt',
    url: 'https://github.com/JetBrains/JetBrainsMono',
  },
  {
    name: 'Noto Color Emoji',
    version: 'COLRv1',
    holder: 'Copyright 2013 Google LLC',
    license: 'SIL Open Font License, Version 1.1',
    file: 'NotoColorEmoji-OFL.txt',
    url: 'https://github.com/googlefonts/noto-emoji',
  },
  {
    name: 'KaTeX',
    version: KATEX_VERSION,
    holder: 'Copyright (c) 2013-2020 Khan Academy and other contributors',
    license: 'MIT License',
    file: 'KaTeX-MIT.txt',
    url: 'https://katex.org/',
  },
  {
    name: 'Pagefind',
    version: PAGEFIND_VERSION,
    holder: 'Copyright 2022 Pagefind',
    license: 'MIT License',
    file: 'Pagefind-MIT.txt',
    url: 'https://pagefind.app/',
  },
];

function licenseText(file) {
  const text = licenseTexts[`../assets/licenses/${file}`];
  if (text === undefined) throw new Error(`missing license text for ${file}`);
  return text;
}
---

<BaseLayout title="licenses · duplexsystem" description="Licenses.">
  <Panel title="licenses" meta="~/licenses">
    <div class="measure">
      <h2>This site</h2>
      <p>
        <a href={REPO}>This site</a> is licensed under the terms of the <a href={AGPL}
          >GNU Affero General Public License, version 3 or later</a
        >. Some portions may be licensed separately and are described below.
      </p>

      <h2>JavaScript Licenses</h2>
      <p>
        Per the <a href="https://www.gnu.org/licenses/javascript-labels.html"
          >GNU JavaScript License Web Labels</a
        > convention, all scripts on this site are appropriately tagged.
      </p>
      <table id="jslicense-labels1">
        <tr><td><b>File</b></td><td><b>License</b></td><td><b>Source</b></td></tr>
        {
          SCRIPTS.map((s) => (
            <tr>
              <td>
                <a href={s.file}>{s.file.split('/').pop()}</a>
              </td>
              <td>
                <a href={s.licenseUrl}>{s.license}</a>
              </td>
              <td>
                <a href={s.source}>{s.sourceLabel}</a>
              </td>
            </tr>
          ))
        }
      </table>

      <h2>Third-party Licenses</h2>
      {
        COMPONENTS.map((c) => (
          <>
            <h3>
              {c.name} {c.version}
            </h3>
            <p>
              {c.holder} · <a href={c.url}>{c.url}</a> · {c.license}
            </p>
            <pre>{licenseText(c.file)}</pre>
          </>
        ))
      }
    </div>
  </Panel>
</BaseLayout>

<style>
  table {
    border-collapse: collapse;
    margin: 1rem 0;
    width: 100%;
  }
  table :is(td, th) {
    border: 1px solid var(--line);
    padding: 0.3rem 0.6rem;
    text-align: left;
  }
  pre {
    white-space: pre-wrap;
    font-family: var(--font-jetbrains), ui-monospace, monospace;
    font-size: 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.8rem;
    margin: 0 0 1.5rem;
  }
</style>
